# WIGOS Node — 环境变量模板。复制成 .env 后**必须**改掉这三项：
#   POSTGRES_PASSWORD / DJANGO_SECRET_KEY / DJANGO_ALLOWED_HOSTS
# 原因：这三项在仓库里公开，照抄等于把库口令和 session 签名密钥一起公开。

POSTGRES_DB=app_db
POSTGRES_USER=app_user
# 改掉。模板值只保证本机 docker compose 起得来。
POSTGRES_PASSWORD=change-me-app-db-password
# 容器内互访写 db；宿主机直连写 127.0.0.1
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
# 留成下面这个占位值时，DJANGO_DEBUG=false 下应用会拒绝启动 —— 这是故意的，
# 用公开密钥签 session cookie 等于没有认证。
DJANGO_SECRET_KEY=change-me-in-dev
# 默认关闭。true 会把完整堆栈、绝对路径、DATABASES 结构返回给浏览器。
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# 浏览器发起 POST/PUT/DELETE 时，Django 会校验 Origin 是否可信。
# 少了这一段，凡是不在默认白名单里的地址（换端口、用 IP、走域名）写操作全 403，
# 而 curl 因为不带 Origin 头反而能过 —— 只跑接口测试发现不了，只有真浏览器才暴露。
# 逗号分隔，多个地址全列出，必须带 http:// 或 https:// 和端口。
# 留空 = 由 DJANGO_ALLOWED_HOSTS 推导出 5173/5174/5175 三个端口。
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# WIS2 Notification Message：本节点的中心标识，以及 WNM 里 links[].href 指向的
# 公开 web storage 地址。不发布就用默认值。
WNM_CENTRE_ID=io-wis2dev-test-wigosnode
WNM_STORAGE_URL=https://wigosnode.test.wis2dev.io/webstorage

# 已发布记录文件的存储（上游新增的 minio 服务，S3 兼容）。
# 原版这两项默认值就是 minioadmin，与库口令同属"照抄等于公开"，这里改占位。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
WNM_STORAGE_ACCESS_KEY=minioadmin
WNM_STORAGE_SECRET_KEY=change-me-storage-secret-key
# 节点自己取文件用的地址，默认取下面的 endpoint + bucket
# WNM_STORAGE_ENDPOINT=minio:9000
# WNM_STORAGE_BUCKET=webstorage
# WNM_STORAGE_SECURE=false
# WNM_STORAGE_INTERNAL_URL=http://minio:9000/webstorage
# 缺桶时自动建桶并设成匿名可读。原版默认跟随 DJANGO_DEBUG；本分支的 DEBUG
# 默认已是 false，所以这里同样默认 false —— 否则不配就会得到一个公网可读的桶。
# WNM_STORAGE_CREATE_BUCKET=false
