AddPOSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password

DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web storage for published record files (the minio service by default)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WNM_STORAGE_ACCESS_KEY=minioadmin
WNM_STORAGE_SECRET_KEY=minioadmin
# Public base URL of the stored files, used in the WNM links
WNM_STORAGE_URL=http://localhost:9000/webstorage
# WNM_STORAGE_ENDPOINT=minio:9000
# WNM_STORAGE_BUCKET=webstorage
# WNM_STORAGE_SECURE=false
# WNM_STORAGE_INTERNAL_URL=http://minio:9000/webstorage
# WNM_STORAGE_CREATE_BUCKET=true  # default: DJANGO_DEBUG

# MQTT broker for WNMs (the mosquitto service by default). The URL's user and
# password must match MQTT_USERNAME and MQTT_PASSWORD.
MQTT_USERNAME=wis2
MQTT_PASSWORD=wis2
WIS2_BROKER_URL=mqtt://wis2:wis2@mosquitto:1883
# WIS2_TOPIC=origin/a/wis2/<centre id>/TBD-wmdr2  # placeholder, not decided yet
# WIS2_PUBLISH_WNM=false  # store the files, but send no WNMs
